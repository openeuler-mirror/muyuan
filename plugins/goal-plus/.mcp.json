{
  "mcpServers": {
    "goal-plus": {
      "command": "bash",
      "args": [
        "${PLUGIN_ROOT}/scripts/run-runtime.sh",
        "--root",
        ".gp"
      ],
      "env_vars": [
        "CODEX_HOME",
        "PI_CODING_AGENT_DIR",
        "GOAL_PLUS_OUTER_DEADLINE_AT",
        "GOAL_PLUS_DEVICE_POOLS",
        "GOAL_PLUS_VERIFIER_RESOURCE_LOCK_DIR",
        "GOAL_PLUS_SUPPLEMENTAL_EVALUATION_ENABLED",
        "GOAL_PLUS_SUPPLEMENTAL_EVALUATION_REQUIRED",
        "GOAL_PLUS_EVIDENCE_ANNOTATOR_REASONING_EFFORT"
      ],
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 300,
      "enabled": true,
      "default_tools_approval_mode": "approve"
    }
  }
}
