+def traverse_graph(output_tensor, input_tensor, graph: "Graph", visited: Optional[Dict[int, int]] = None):
+    """Walk the autograd graph from ``output_tensor`` back toward ``input_tensor``.
+
+    Builds a memory graph by creating :class:`GraphNode` entries (with op type and
+    saved-tensor information) and connecting parent/child nodes with edges. Emits a
+    warning when ``output_tensor`` has no ``grad_fn`` and therefore no graph to walk.
+    """
+    if visited is None:
+        visited = {}
+
+    grad_fn = getattr(output_tensor, "grad_fn", None)
+    if grad_fn is None:
+        warnings.warn(
+            "output tensor has no grad_fn; cannot traverse the autograd graph"
+        )
+        return
+
+    _traverse_grad_fn(grad_fn, output_tensor, input_tensor, graph, visited)
