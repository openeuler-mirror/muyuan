+def sanitize_filename(title: str) -> str:
+    """Convert a paper title into a filesystem-safe filename.
+
+    The returned string contains only ASCII letters, digits and underscores
+    so that it can safely be used as a file name on every operating system.
+
+    Special characters that frequently appear in paper titles -- quotes,
+    colons, parentheses, em-dashes, guillemets, non-ASCII letters, etc. -- are
+    removed or collapsed into a single underscore.  Titles that become empty
+    after sanitization (this includes the empty string as well as titles made
+    up entirely of non-ASCII characters) fall back to the safe default name
+    :data:`DEFAULT_FILENAME`.
+    """
+    if not title:
+        return DEFAULT_FILENAME
+
+    # Decompose accented characters into their base ASCII form (e.g. "é" ->
+    # "e") and drop anything that cannot be represented in ASCII (e.g.
+    # Cyrillic letters, guillemets, em-dashes).
+    normalized = unicodedata.normalize("NFKD", title)
+    ascii_text = normalized.encode("ascii", "ignore").decode("ascii")
+
+    # Replace every run of non-alphanumeric characters with a single
+    # underscore so that we never end up with consecutive separators.
+    safe = re.sub(r"[^A-Za-z0-9]+", "_", ascii_text)
+
+    # Trim leading/trailing underscores that may have been introduced above.
+    safe = safe.strip("_")
+
+    if not safe:
+        return DEFAULT_FILENAME
+
+    # Keep the file name to a reasonable length to stay well below the common
+    # 255-byte filesystem limit.
+    if len(safe) > MAX_FILENAME_LENGTH:
+        safe = safe[:MAX_FILENAME_LENGTH].strip("_") or DEFAULT_FILENAME
+
+    return safe
 
 
