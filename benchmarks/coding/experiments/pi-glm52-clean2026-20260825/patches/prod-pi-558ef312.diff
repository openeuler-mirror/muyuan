+
+class Graph:
+    """A container for building a computation graph.
+
+    Nodes can be added and their saved memory is accumulated into a running
+    total. Edges record the source and destination node identifiers.
+    """
+
+    def __init__(self):
+        self.nodes: List[GraphNode] = []
+        self.edges: List[GraphEdge] = []
+        self.total_saved_memory_bytes: int = 0
+
+    def add_node(self, node: GraphNode) -> None:
+        """Add a node and accumulate its saved memory into the running total."""
+        self.nodes.append(node)
+        self.total_saved_memory_bytes += node.saved_memory_bytes
+
+    def add_edge(self, src_id: int, dst_id: int) -> None:
+        """Record an edge between a source and destination node identifier."""
+        self.edges.append(GraphEdge(src_id=src_id, dst_id=dst_id))

