+def _is_tensor_like(value):
+    """Return True if value looks like a tensor (duck-typed)."""
+    return (
+        value is not None
+        and hasattr(value, "shape")
+        and hasattr(value, "dtype")
+        and callable(getattr(value, "nelement", None))
+        and callable(getattr(value, "element_size", None))
+    )
+
+
+def _is_recognized_saved_attr(name):
+    """Return True if name is a recognized saved-tensor attribute."""
+    if name.startswith("_raw_saved_"):
+        return False
+    if name.startswith("_saved_mat"):
+        return True
+    return name in ("_saved_result", "_saved_bias", "_saved_weight")
+
+
+def extract_saved_tensors(grad_fn):
+    """Walk a grad_fn's saved attributes and return metadata for saved tensors.
+
+    Returns a list of dicts with keys: name, shape, dtype, size_bytes,
+    size_formatted. Recognized saved tensors are attributes starting with
+    ``_saved_mat`` plus ``_saved_result``, ``_saved_bias`` and
+    ``_saved_weight``. ``_raw_saved_`` variants, None values, non-tensor
+    values and attributes that raise ``RuntimeError`` on access are skipped.
+    """
+    results = []
+    for attr_name in dir(grad_fn):
+        if not _is_recognized_saved_attr(attr_name):
+            continue
+        try:
+            value = getattr(grad_fn, attr_name)
+        except RuntimeError:
+            continue
+        if value is None:
