--- a/repo_manager.py
+++ b/repo_manager.py
@@ -130,6 +130,69 @@
     return clone_repo(clone_url, repo_dir, repo, logger=logger)
 
 
+def clone_repo_with_fork(owner: str, repo: str, fork_owner: str, fork_name: str,
+                         repo_dir: str, issue_url: str = '',
+                         token: str = '', logger=None) -> Optional[str]:
+    """Clone the upstream repository and configure a ``fork`` remote.
+
+    Cloning a freshly created fork frequently returns an empty repository or
+    times out, which prevents us from obtaining the complete git objects
+    needed for the subsequent work.  To avoid that we clone the upstream
+    repository instead (it always carries the full, ready history) and
+    afterwards register a ``fork`` remote pointing at the fork so the prepared
+    changes can be pushed back and a pull request can be opened against the
+    upstream.
+    """
+    if 'gitcode.com' in issue_url:
+        upstream_url = f"http/workspace/gitcode.com/{owner}/{repo}.git"
+        fork_url = f"http/workspace/gitcode.com/{fork_owner}/{fork_name}.git"
+    else:
+        upstream_url = f"http/workspace/atomgit.com/{owner}/{repo}.git"
+        fork_url = f"http/workspace/atomgit.com/{fork_owner}/{fork_name}.git"
+
+    # 1) Clone the upstream repository to obtain the complete git objects.
+    #    A freshly forked repository may still be empty or slow to serve, so
+    #    cloning the upstream avoids the empty-repo / timeout problem.
+    repo_path = clone_repo(upstream_url, repo_dir, repo, logger=logger)
+    if repo_path is None:
+        return None
+
+    # 2) Configure the fork remote so changes can be pushed to the fork.
+    #    Embed the token in the push URL so authentication works for pushes.
+    if token:
+        if 'gitcode.com' in issue_url:
+            push_url = (
+                f"http/workspace/oauth2:{token}@gitcode.com/"
+                f"{fork_owner}/{fork_name}.git"
+            )
+        else:
+            push_url = (
+                f"http/workspace/oauth2:{token}@atomgit.com/"
+                f"{fork_owner}/{fork_name}.git"
+            )
+    else:
+        push_url = fork_url
+
+    # Remove a possibly existing fork remote before (re)adding it.
+    subprocess.run(
+        ['git', 'remote', 'remove', 'fork'],
+        cwd=repo_path, capture_output=True, text=True
+    )
+    result = subprocess.run(
+        ['git', 'remote', 'add', 'fork', push_url],
+        cwd=repo_path, capture_output=True, text=True
+    )
+    if result.returncode != 0:
+        if logger:
+            logger.error(f"  配置 fork 远程失败 - {result.stderr.strip()}")
+        return None
+
+    if logger:
+        logger.info(f"  已配置 fork 远程: {fork_url}")
+
+    return repo_path
+
+
