+def _looks_like_tensor(value: Any) -> bool:
+    """Return True if ``value`` quacks like a tensor.
+
+    We rely on duck typing so that both real ``torch.Tensor`` objects and
+    lightweight fakes can be inspected: a tensor exposes ``shape`` and
+    ``dtype`` attributes as well as callable ``nelement``/``element_size``
+    methods.
+    """
+    return (
+        hasattr(value, "shape")
+        and hasattr(value, "dtype")
+        and callable(getattr(value, "nelement", None))
+        and callable(getattr(value, "element_size", None))
+    )
+
+
+def _is_recognized_saved_name(name: str) -> bool:
+    """Return True if ``name`` refers to a recognized saved-tensor attribute."""
+    if name.startswith("_raw_saved_"):
+        return False
+    if name.startswith("_saved_mat"):
+        return True
+    return name in _RECOGNIZED_SAVED_NAMES
+
+
+def extract_saved_tensors(grad_fn) -> List[Dict[str, Any]]:
+    """Extract saved-tensor metadata from an autograd ``grad_fn`` object.
+
+    Walks the ``grad_fn``'s saved attributes and returns a list of dicts --
+    one per recognized saved tensor -- with the keys ``name``, ``shape``,
+    ``dtype``, ``size_bytes`` and ``size_formatted``.
+
+    Recognized attributes are those starting with ``_saved_mat`` plus
+    ``_saved_result``, ``_saved_bias`` and ``_saved_weight``. The following
+    are skipped:
+
+    * ``_raw_saved_*`` variants,
+    * attributes whose value is ``None``,
+    * non-tensor values,
+    * attributes that raise ``RuntimeError`` on access.
+    """
+    results: List[Dict[str, Any]] = []
+    for name in dir(grad_fn):
+        if not _is_recognized_saved_name(name):
+            continue
+        try:
+            value = getattr(grad_fn, name)
+        except RuntimeError:
+            continue
+        if value is None:
+            continue
+        if not _looks_like_tensor(value):
+            continue
+        size_bytes = calculate_tensor_memory(value)
+        results.append(
+            {
+                "name": name,
+                "shape": list(value.shape),
+                "dtype": str(value.dtype),
+                "size_bytes": size_bytes,
+                "size_formatted": format_bytes(size_bytes),
+            }
+        )
+    return results
 
 
