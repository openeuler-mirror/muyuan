+def sanitize_filename(title: str, max_length: int = 20) -> str:
+    """Convert a paper title into a safe filename.
+
+    The resulting filename contains only ASCII letters, digits and
+    underscores.  Special characters such as quotes, colons, brackets and
+    non-ASCII characters (e.g. Cyrillic, CJK, accented letters) are either
+    transliterated or replaced with underscores so that the generated JSON
+    files in ``papers_archive`` always have portable, safe names.
+    """
+    # Fallback used when the title does not yield any usable characters.
+    fallback = "untitled"
+
+    if title is None:
+        return fallback
+
+    # 1. Decompose accented characters into their base letter + combining
+    #    marks (e.g. "é" -> "e" + combining acute) so that the subsequent
+    #    ASCII step can keep the base letter.
+    cleaned = unicodedata.normalize("NFKD", title)
+
+    # 2. Drop anything that is not ASCII (Cyrillic, CJK, guillemets, …).
+    cleaned = cleaned.encode("ascii", "ignore").decode("ascii")
+
+    # 3. Collapse all whitespace runs into a single underscore.
+    cleaned = re.sub(r"\s+", "_", cleaned)
+
+    # 4. Replace every remaining character that is not a letter, digit or
+    #    underscore (quotes, colons, brackets, hyphens, punctuation, …).
+    cleaned = re.sub(r"[^a-zA-Z0-9_]", "_", cleaned)
+
+    # 5. Collapse runs of underscores produced by the replacements above.
+    cleaned = re.sub(r"_+", "_", cleaned)
+
+    # 6. Strip leading/trailing underscores.
+    cleaned = cleaned.strip("_")
+
+    # 7. Truncate to the requested maximum length without leaving a
+    #    dangling underscore at the end.
+    if len(cleaned) > max_length:
+        cleaned = cleaned[:max_length].rstrip("_")
+
+    return cleaned if cleaned else fallback
 
 
