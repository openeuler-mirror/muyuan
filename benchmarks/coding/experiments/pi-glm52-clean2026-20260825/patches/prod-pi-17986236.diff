@@ -130,6 +130,72 @@
     return clone_repo(clone_url, repo_dir, repo, logger=logger)
 
 
+def _build_fork_clone_url(username: str, fork_name: str,
+                          issue_url: str = '') -> str:
+    if 'gitcode.com' in issue_url:
+        return f"http/workspace/gitcode.com/{username}/{fork_name}.git"
+    return f"http/workspace/atomgit.com/{username}/{fork_name}.git"
+
+
+def clone_repo_with_fork(owner: str, repo: str, fork_name: str, username: str,
+                          repo_dir: str, issue_url: str = '', token: str = '',
+                          logger=None) -> Optional[str]:
+    """Clone the upstream source repository and configure a fork remote.
+
+    A freshly created fork may report as empty or time out before its git
+    objects are ready. To guarantee a complete set of git objects we clone
+    from the upstream source repository instead of the fork. After cloning,
+    a ``fork`` remote pointing at the user's fork is configured so that
+    changes can be pushed back and a PR opened against the upstream repo.
+    """
+    # 1. Clone from the upstream source to obtain complete git objects,
+    #    avoiding the empty-fork / timeout problem.
+    repo_path = clone_repo_from_source(
+        owner, repo, repo_dir, issue_url=issue_url, logger=logger)
+    if repo_path is None:
+        if logger:
+            logger.error("  克隆上游仓库失败，无法配置 fork 远程仓库")
+        return None
+
+    # 2. Configure the fork remote so changes can be pushed to the fork.
+    fork_clone_url = _build_fork_clone_url(
+        username, fork_name, issue_url=issue_url)
+
+    if token:
+        fork_clone_url = fork_clone_url.replace(
+            '://', f'://oauth2:{token}@', 1)
+
+    # Remove any pre-existing fork remote first so we always end up with the
+    # correct URL, then add it back.
+    subprocess.run(
+        ['git', 'remote', 'remove', 'fork'],
+        cwd=repo_path,
+        capture_output=True,
+        text=True
+    )
+
+    result = subprocess.run(
+        ['git', 'remote', 'add', 'fork', fork_clone_url],
+        cwd=repo_path,
+        capture_output=True,
+        text=True
+    )
+
+    if result.returncode != 0:
+        # Fall back to set-url in case the remote could not be added.
+        subprocess.run(
+            ['git', 'remote', 'set-url', 'fork', fork_clone_url],
+            cwd=repo_path,
+            capture_output=True,
+            text=True
+        )
+
+    if logger:
+        logger.info(f"  已配置 fork 远程仓库: {fork_clone_url}")
+
+    return repo_path
+
+
