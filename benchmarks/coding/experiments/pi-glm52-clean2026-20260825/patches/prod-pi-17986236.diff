+def _set_remote_url(repo_path: str, name: str, url: str) -> None:
+    """Set a remote's URL, creating the remote if it does not exist yet."""
+    check = subprocess.run(
+        ['git', 'config', '--get', f'remote.{name}.url'],
+        cwd=repo_path, capture_output=True, text=True
+    )
+    if check.returncode == 0:
+        subprocess.run(
+            ['git', 'remote', 'set-url', name, url],
+            cwd=repo_path, capture_output=True
+        )
+    else:
+        subprocess.run(
+            ['git', 'remote', 'add', name, url],
+            cwd=repo_path, capture_output=True
+        )
+
+
+def clone_repo_with_fork(owner: str, repo: str, repo_dir: str,
+                          fork_owner: str, fork_name: str,
+                          issue_url: str = '', logger=None) -> Optional[str]:
+    """Clone the full content from the upstream source repository.
+
+    Cloning the fork directly may fail (e.g. the fork is still being populated
+    or is empty). To work around this we clone the complete content from the
+    upstream source repository and then reconfigure the remotes so that the
+    fork is ``origin`` (the push target) and the upstream source is
+    ``upstream``.
+    """
+    if 'gitcode.com' in issue_url:
+        base = "http/workspace/gitcode.com"
+    else:
+        base = "http/workspace/atomgit.com"
+
+    upstream_clone_url = f"{base}/{owner}/{repo}.git"
+    fork_clone_url = f"{base}/{fork_owner}/{fork_name}.git"
+
+    # Clone the full content from the upstream source repository.
+    repo_path = clone_repo(upstream_clone_url, repo_dir, repo, logger=logger)
+    if repo_path is None:
+        return None
+
+    # Reconfigure remotes: fork -> origin (push target), upstream source -> upstream.
+    if logger:
+        logger.info(f"  配置远程仓库: origin -> {fork_clone_url}")
+        logger.info(f"  配置远程仓库: upstream -> {upstream_clone_url}")
+
+    _set_remote_url(repo_path, 'origin', fork_clone_url)
+    _set_remote_url(repo_path, 'upstream', upstream_clone_url)
+
+    return repo_path
+
+
 def download_patch(url: str, output_dir: str, cve_id: str, logger=None) -> Optional[str]:
