+def sanitize_filename(title: str, max_length: int = 20) -> str:
+    """Convert a paper title into a safe filename.
+
+    Removes special characters, replaces whitespace with underscores,
+    truncates the result to ``max_length`` characters, and returns a
+    hash-based fallback name for empty or otherwise problematic titles.
+    """
+    raw = title or ""
+
+    # Remove special characters (keep alphanumerics and whitespace).
+    cleaned = re.sub(r"[^a-zA-Z0-9\s]", "", raw)
+    # Collapse whitespace runs into single underscores.
+    cleaned = re.sub(r"\s+", "_", cleaned.strip())
+    # Truncate to the requested maximum length.
+    cleaned = cleaned[:max_length]
+
+    # Fall back to a deterministic hash-based name for empty/problematic titles.
+    if not cleaned:
+        digest = hashlib.md5(raw.encode("utf-8")).hexdigest()[:8]
+        return f"paper_{digest}"
+
+    return cleaned
 
 
