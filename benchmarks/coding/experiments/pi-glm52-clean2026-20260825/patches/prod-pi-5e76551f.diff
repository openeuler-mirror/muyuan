+    def _parse_rss_feed(self, xml_content: bytes) -> List[Dict[str, Any]]:
+        """Parse RSS/Atom XML content into article dicts.
+
+        Returns an empty list if the content cannot be parsed.
+        """
+        articles: List[Dict[str, Any]] = []
