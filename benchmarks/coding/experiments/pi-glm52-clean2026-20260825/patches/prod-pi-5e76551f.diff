+    def _parse_rss_item(self, item) -> Optional[Dict[str, Any]]:
+        """Parse a single RSS/Atom item element into an article dict."""
+        atom_ns = "{http://www.w3.org/2005/Atom}"
+        dc_ns = "{http://purl.org/dc/elements/1.1/}"
+
+        def _findtext(names):
