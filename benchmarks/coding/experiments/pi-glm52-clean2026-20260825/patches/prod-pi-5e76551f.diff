+def clone_repo_with_fork(owner: str, repo: str, username: str, fork_name: str,
+                          repo_dir: str, issue_url: str = '', token: str = '',
+                          logger=None) -> Optional[str]:
+    """从上游源仓库克隆完整内容，并将 fork 设为 origin、上游源设为 upstream。
+
+    直接克隆 fork 仓库可能会失败（fork 刚创建尚未同步完整内容），因此改为
+    从上游源仓库克隆完整内容，再重新配置远程仓库：
+      - origin    -> fork 仓库（用于后续推送）
+      - upstream  -> 上游源仓库（用于后续同步）
+    """
+    if 'gitcode.com' in issue_url:
+        base = "http/workspace/gitcode.com"
+    else:
+        base = "http/workspace/atomgit.com"
+
+    upstream_url = f"{base}/{owner}/{repo}.git"
+    fork_url = f"{base}/{username}/{fork_name}.git"
+
+    # 从上游源仓库克隆完整内容（克隆后默认 origin 指向上游源仓库）
+    repo_path = clone_repo(upstream_url, repo_dir, repo, logger=logger)
+    if repo_path is None:
+        return None
+
+    # 将 origin 重新指向 fork 仓库，以便后续推送到 fork
+    set_origin = subprocess.run(
+        ['git', 'remote', 'set-url', 'origin', fork_url],
+        cwd=repo_path, capture_output=True, text=True
+    )
+    if set_origin.returncode != 0 and logger:
+        logger.warning(f"  设置 origin 失败 - {set_origin.stderr.strip()}")
+
+    # 添加 upstream 远程指向上游源仓库
+    add_upstream = subprocess.run(
+        ['git', 'remote', 'add', 'upstream', upstream_url],
+        cwd=repo_path, capture_output=True, text=True
+    )
+    if add_upstream.returncode != 0:
+        # upstream 可能已存在，尝试更新其地址
+        subprocess.run(
+            ['git', 'remote', 'set-url', 'upstream', upstream_url],
+            cwd=repo_path, capture_output=True, text=True
+        )
+
+    if logger:
+        logger.info(f"  origin -> {fork_url}")
+        logger.info(f"  upstream -> {upstream_url}")
+
+    return repo_path
+
