+def sanitize_filename(title: str, max_length: int = 80) -> str:
+    """Convert a paper title into a safe filename.
+
+    The resulting filename contains only ASCII letters, digits and
+    underscores.  Special characters such as quotes, colons, parentheses
+    and non-ASCII characters are removed or replaced so that the file can
+    be safely written to disk on any operating system.
+
+    Args:
+        title: The paper title to sanitize.
+        max_length: Maximum number of characters to keep.
+
+    Returns:
+        A string consisting only of ``[a-zA-Z0-9_]``.  When the title is
+        empty or becomes empty after sanitization, the safe default
+        ``"untitled"`` is returned.
+    """
+    if not title:
+        return "untitled"
+
+    # Decompose accented characters (e.g. "é" -> "e") and drop anything
+    # that cannot be represented in ASCII.
+    text = unicodedata.normalize("NFKD", str(title))
+    text = text.encode("ascii", "ignore").decode("ascii")
+
+    # Replace any run of whitespace with a single underscore.
+    text = re.sub(r"\s+", "_", text)
+
+    # Remove every character that is not an ASCII letter, digit or
+    # underscore (quotes, colons, parentheses, hyphens, ...).
+    text = re.sub(r"[^a-zA-Z0-9_]", "", text)
+
+    # Collapse repeated underscores and trim the ends.
+    text = re.sub(r"_+", "_", text).strip("_")
+
+    if not text:
+        return "untitled"
+
+    # Keep the filename reasonably short to avoid filesystem limits.
+    if len(text) > max_length:
+        text = text[:max_length].strip("_")
+
+    return text or "untitled"
 
 
