+def _is_tensor_like(value):
+    """Return True if ``value`` looks like a tensor (has shape/dtype and the
+    memory introspection methods)."""
+    return (
+        value is not None
+        and hasattr(value, "shape")
+        and hasattr(value, "dtype")
+        and hasattr(value, "nelement")
+        and callable(getattr(value, "nelement"))
+        and hasattr(value, "element_size")
+        and callable(getattr(value, "element_size"))
+    )
