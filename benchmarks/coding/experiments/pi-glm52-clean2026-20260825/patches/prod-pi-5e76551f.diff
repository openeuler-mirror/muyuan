+def extract_saved_tensors(grad_fn):
+    """Walk a grad_fn's saved attributes and return metadata for recognized
+    saved tensors.
+
+    Recognized attribute names are those starting with ``_saved_mat`` plus the
+    explicit names ``_saved_result``, ``_saved_bias`` and ``_saved_weight``.
+
+    Each returned dict has the keys ``name``, ``shape``, ``dtype``,
+    ``size_bytes`` and ``size_formatted``.
+
+    Skipped: ``_raw_saved_`` variants, ``None`` values, non-tensor values and
+    attributes that raise ``RuntimeError`` on access.
+    """
+    recognized = []
+    for name in dir(grad_fn):
+        if not name.startswith("_saved_"):
+            continue
+        # Skip the raw (un-versioned) saved tensor variants.
+        if name.startswith("_raw_saved_"):
+            continue
+        # Only collect the recognized saved-tensor attribute names.
+        if not (
+            name.startswith("_saved_mat")
+            or name in ("_saved_result", "_saved_bias", "_saved_weight")
+        ):
+            continue
+        try:
+            value = getattr(grad_fn, name)
+        except RuntimeError:
+            continue
+        if not _is_tensor_like(value):
+            continue
+        size_bytes = calculate_tensor_memory(value)
+        recognized.append({
+            "name": name,
+            "shape": list(value.shape),
+            "dtype": str(value.dtype),
+            "size_bytes": size_bytes,
+            "size_formatted": format_bytes(size_bytes),
+        })
+    return recognized
 
 
