+    def _normalize_date(self, date_str: str) -> str:
+        """Normalize a date string from an RSS/Atom feed to ``YYYY-MM-DD``."""
+        if not date_str:
+            return ""
+
+        # RFC 822 (RSS <pubDate>, e.g. "Wed, 10 Apr 2026 12:00:00 GMT")
+        try:
+            dt = parsedate_to_datetime(date_str)
+            if dt is not None:
+                return dt.strftime("%Y-%m-%d")
+        except (TypeError, ValueError, OverflowError):
+            pass
+
+        # ISO 8601 (Atom, e.g. "2026-04-10T12:00:00.000Z")
+        iso_str = date_str.strip().replace("Z", "+00:00")
+        try:
+            dt = datetime.fromisoformat(iso_str)
+            return dt.strftime("%Y-%m-%d")
+        except ValueError:
+            pass
+
+        # Fallback to a few common explicit formats.
+        for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d", "%Y/%m/%d"):
+            try:
+                dt = datetime.strptime(date_str.strip()[: len(fmt)], fmt)
+                return dt.strftime("%Y-%m-%d")
+            except ValueError:
+                continue
+
+        return ""
