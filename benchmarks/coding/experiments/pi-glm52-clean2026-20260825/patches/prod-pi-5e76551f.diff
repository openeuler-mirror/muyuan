+def _has_git_objects(repo_path: str) -> bool:
+    """Check whether a cloned repository actually contains git objects/refs.
+
+    A freshly created fork may report a successful clone while still being
+    empty (no refs/heads). This helper verifies the clone is usable for
+    subsequent operations.
+    """
+    if not os.path.isdir(repo_path):
+        return False
+
+    result = subprocess.run(
+        ['git', 'rev-parse', 'HEAD'],
+        cwd=repo_path,
+        capture_output=True,
+        text=True
+    )
+    return result.returncode == 0
+
+
+def _configure_remote(repo_path: str, name: str, url: str,
+                       logger=None) -> bool:
+    """Add or update a git remote so it always points at the given url."""
+    result = subprocess.run(
+        ['git', 'remote', 'get-url', name],
+        cwd=repo_path,
+        capture_output=True,
+        text=True
+    )
+
+    if result.returncode == 0:
+        set_result = subprocess.run(
+            ['git', 'remote', 'set-url', name, url],
+            cwd=repo_path,
+            capture_output=True,
+            text=True
+        )
+        if set_result.returncode != 0 and logger:
+            logger.warning(f"  更新远程仓库 {name} 失败 - {set_result.stderr.strip()}")
+        return set_result.returncode == 0
+
+    add_result = subprocess.run(
+        ['git', 'remote', 'add', name, url],
+        cwd=repo_path,
+        capture_output=True,
+        text=True
+    )
+    if add_result.returncode != 0 and logger:
+        logger.warning(f"  配置远程仓库 {name} 失败 - {add_result.stderr.strip()}")
+    return add_result.returncode == 0
+
+
+def clone_repo_with_fork(owner: str, repo: str, fork_owner: str,
+                         fork_name: str, repo_dir: str,
+                         issue_url: str = '', token: str = '',
+                         logger=None, max_attempts: int = 3,
+                         wait_interval: int = 30,
+                         clone_timeout: int = 300) -> Optional[str]:
+    """Clone a fork repository and configure remotes for a fork-based PR flow.
+
+    This addresses two issues compared with a plain ``git clone``:
+
+    1. A freshly created fork may still be empty or the clone may time out
+       before all git objects are transferred. We retry the clone, clean up
+       partial clones, and verify that the resulting repository actually
+       contains git objects before continuing.
+    2. After a successful clone the fork remote is configured (``origin`` and
+       ``fork`` point at the fork, ``upstream`` points at the source) so that
+       local changes can be pushed back to the fork and a PR opened against
+       the upstream repository.
+    """
+    if 'gitcode.com' in issue_url:
+        base = "http/workspace/gitcode.com"
+    else:
+        base = "http/workspace/atomgit.com"
+
+    fork_clone_url = f"{base}/{fork_owner}/{fork_name}.git"
+    upstream_clone_url = f"{base}/{owner}/{repo}.git"
+
+    repo_path = os.path.join(repo_dir, fork_name)
+
+    if os.path.exists(repo_path) and _has_git_objects(repo_path):
+        if logger:
+            logger.info(f"  仓库已存在: {repo_path}")
+    else:
+        os.makedirs(repo_dir, exist_ok=True)
+
+        # Remove any leftover empty/partial clone so we can start fresh.
+        if os.path.exists(repo_path):
+            shutil.rmtree(repo_path, ignore_errors=True)
+
+        if logger:
+            logger.info(f"  克隆 fork 仓库: {fork_clone_url}")
+
+        result = None
+        for attempt in range(1, max_attempts + 1):
+            try:
+                result = subprocess.run(
+                    ['git', 'clone', fork_clone_url, repo_path],
+                    capture_output=True,
+                    text=True,
+                    timeout=clone_timeout
+                )
+            except subprocess.TimeoutExpired:
+                result = None
+                if logger:
+                    logger.warning(
+                        f"  克隆超时 (>{clone_timeout}s)，fork 可能尚未就绪")
+            except Exception as e:
+                result = None
+                if logger:
+                    logger.warning(f"  克隆异常: {e}")
+
+            if result is not None and result.returncode == 0 \
+                    and _has_git_objects(repo_path):
+                if logger:
+                    logger.info(f"  克隆成功")
+                break
+
+            stderr = result.stderr.strip() if result is not None else ''
+            if logger:
+                logger.warning(f"  克隆失败或仓库为空 - {stderr}")
+
+            # Clean up partial/empty clone before retrying.
+            if os.path.exists(repo_path):
+                shutil.rmtree(repo_path, ignore_errors=True)
+
+            if attempt < max_attempts:
+                if logger:
+                    logger.info(
+                        f"  等待 {wait_interval} 秒后重试 "
+                        f"(fork 可能尚未完成初始化)..."
+                    )
+                time.sleep(wait_interval)
+                if logger:
+                    logger.info(f"  重试克隆: {fork_clone_url}")
+
+        if not os.path.exists(repo_path) or not _has_git_objects(repo_path):
+            if logger:
+                logger.error(f"  克隆 fork 仓库失败，结束执行")
+            return None
+
+    # Configure remotes so changes can be pushed to the fork and a PR opened
+    # against the upstream repository.
+    if logger:
+        logger.info(f"  配置远程仓库: origin/fork -> {fork_clone_url}, "
+                     f"upstream -> {upstream_clone_url}")
+
+    _configure_remote(repo_path, 'origin', fork_clone_url, logger=logger)
+    _configure_remote(repo_path, 'fork', fork_clone_url, logger=logger)
+    _configure_remote(repo_path, 'upstream', upstream_clone_url, logger=logger)
+
+    return repo_path
+
+
 def download_patch(url: str, output_dir: str, cve_id: str, logger=None) -> Optional[str]:
     os.makedirs(output_dir, exist_ok=True)
 

